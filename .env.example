# Runtime directories are relative to the repository by default.
CLAUSEGRID_ARTIFACT_ROOT=artifacts/runs

# Export exactly one provider credential in the process environment at runtime.
# Do not write its value into this file or the repository:
# OPENAI_API_KEY
# ANTHROPIC_API_KEY          # Used by both --provider anthropic and --provider claude
# DEEPSEEK_API_KEY
# NVIDIA_NIM_API_KEY
# OPENCODE_API_KEY           # OpenCode Zen; exact model remains an explicit CLI choice
# QUBRID_API_KEY             # Qubrid OpenAI-compatible API
# OPENROUTER_API_KEY
# GROQ_API_KEY
# TOGETHER_API_KEY
# GEMINI_API_KEY
# MISTRAL_API_KEY
# XAI_API_KEY
# MY_OPENAI_COMPATIBLE_KEY   # Name is selected with --api-key-env

# Public-demo deployment metadata (not needed for local loopback use).
# Put the selected provider's key value in CLAUSEGRID_API_KEY on the hosting platform.
# CLAUSEGRID_API_KEY          # Secret; never commit a value.
# CLAUSEGRID_PROVIDER=qubrid
# CLAUSEGRID_MODEL=deepseek-ai/DeepSeek-V3.2
# CLAUSEGRID_BASE_URL=https://gateway.example/v1  # openai-compatible only
# CLAUSEGRID_ARTIFACT_ROOT=/tmp/clausegrid
# CLAUSEGRID_MAX_AUDITS_PER_HOUR=6
# CLAUSEGRID_MAX_AUDITS_PER_CLIENT_HOUR=2
# CLAUSEGRID_ADMIN_TOKEN      # Secret; configure in the deployment platform, never here.
