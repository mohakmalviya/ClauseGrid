# Runtime directories are relative to the repository by default.
FORMULAWITNESS_ARTIFACT_DIR=artifacts/runs

# Export exactly one provider credential in the process environment at runtime.
# Do not write its value into this file or the repository:
# OPENAI_API_KEY
# ANTHROPIC_API_KEY          # Used by both --provider anthropic and --provider claude
# DEEPSEEK_API_KEY
# NVIDIA_NIM_API_KEY
# OPENCODE_API_KEY           # OpenCode Zen; exact model remains an explicit CLI choice
# MY_OPENAI_COMPATIBLE_KEY   # Name is selected with --api-key-env

# Public-demo deployment metadata (not needed for local loopback use).
# FORMULAWITNESS_PUBLIC_ORIGIN=https://your-service.example
# FORMULAWITNESS_PROVIDER=nvidia-nim
# FORMULAWITNESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# FORMULAWITNESS_ARTIFACT_ROOT=/tmp/formulawitness
# FORMULAWITNESS_MAX_AUDITS_PER_HOUR=6
# FORMULAWITNESS_MAX_AUDITS_PER_CLIENT_HOUR=2
# FORMULAWITNESS_ADMIN_TOKEN  # Secret; configure in the deployment platform, never here.
